<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="vista" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.CitaController">

    <HBox spacing="18" VBox.vgrow="ALWAYS">

        <!-- Formulario: registrar o editar una cita -->
        <VBox styleClass="tarjeta" minWidth="300" prefWidth="320" maxWidth="340">
            <Label text="Datos de la cita" styleClass="titulo-seccion" />
            <Label text="Complete los campos y presione Guardar. Para modificar o eliminar, primero seleccione una cita en la tabla."
                   styleClass="descripcion-seccion" wrapText="true" minHeight="-Infinity" />
            <Region styleClass="separador" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="scroll-formulario">
                <VBox spacing="12" styleClass="campos-formulario">

                    <VBox spacing="5">
                        <Label text="Cliente *" styleClass="etiqueta" />
                        <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Fecha *" styleClass="etiqueta" />
                            <DatePicker fx:id="dpFecha" promptText="Elegir fecha" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="5" minWidth="110" prefWidth="110">
                            <Label text="Hora *" styleClass="etiqueta" />
                            <TextField fx:id="txtHora" promptText="Ej. 14:30" />
                        </VBox>
                    </HBox>
                    <Label text="La hora se escribe en formato de 24 horas (HH:mm)." styleClass="ayuda" wrapText="true" minHeight="-Infinity" />

                    <VBox spacing="5">
                        <Label text="Tipo de servicio *" styleClass="etiqueta" />
                        <TextField fx:id="txtTipoServicio" promptText="Ej. Mantenimiento de PC" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Descripción *" styleClass="etiqueta" />
                        <TextField fx:id="txtDescripcion" promptText="Ej. Laptop no enciende" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Estado *" styleClass="etiqueta" />
                        <ComboBox fx:id="cmbEstado" promptText="Seleccione un estado" maxWidth="Infinity" />
                    </VBox>

                    <Label text="* Campos obligatorios" styleClass="ayuda" wrapText="true" minHeight="-Infinity" />

                </VBox>
            </ScrollPane>

            <Region styleClass="separador" />
            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar"
                        styleClass="boton-primario" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar"
                        styleClass="boton-acento" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar"
                        styleClass="boton-neutro" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar"
                        styleClass="boton-peligro" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <!-- Listado y filtros de citas -->
        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <VBox spacing="2">
                <Label text="Citas registradas" styleClass="titulo-seccion" />
                <Label text="Haga clic en una cita para cargarla en el formulario." styleClass="descripcion-seccion" wrapText="true" minHeight="-Infinity" />
            </VBox>

            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="5">
                    <Label text="Filtrar por fecha" styleClass="etiqueta" />
                    <DatePicker fx:id="dpFiltroFecha" promptText="Todas las fechas" prefWidth="170" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Filtrar por estado" styleClass="etiqueta" />
                    <ComboBox fx:id="cmbFiltroEstado" promptText="Todos" prefWidth="160" />
                </VBox>
                <Button text="Limpiar filtros" onAction="#limpiarFiltros" styleClass="boton-neutro" />
            </HBox>

            <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No hay citas para mostrar." />
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" minWidth="50" maxWidth="70" />
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180" />
                    <TableColumn fx:id="colFecha" text="Fecha" minWidth="95" prefWidth="100" />
                    <TableColumn fx:id="colHora" text="Hora" minWidth="65" prefWidth="70" />
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="170" />
                    <TableColumn fx:id="colEstado" text="Estado" minWidth="110" prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
