<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="vista" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.ClienteController">

    <HBox spacing="18" VBox.vgrow="ALWAYS">

        <!-- Formulario: registrar o editar un cliente -->
        <VBox styleClass="tarjeta" minWidth="300" prefWidth="320" maxWidth="340">
            <Label text="Datos del cliente" styleClass="titulo-seccion" />
            <Label text="Complete los campos y presione Guardar. Para modificar o eliminar, primero seleccione un cliente en la tabla."
                   styleClass="descripcion-seccion" wrapText="true" minHeight="-Infinity" />
            <Region styleClass="separador" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="scroll-formulario">
                <VBox spacing="12" styleClass="campos-formulario">

                    <VBox spacing="5">
                        <Label text="Nombres *" styleClass="etiqueta" />
                        <TextField fx:id="txtNombres" promptText="Ej. María José" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Apellidos *" styleClass="etiqueta" />
                        <TextField fx:id="txtApellidos" promptText="Ej. López García" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Teléfono *" styleClass="etiqueta" />
                        <TextField fx:id="txtTelefono" promptText="Ej. 8888-7777" />
                        <Label text="Mínimo 8 dígitos. Puede usar espacios, guiones y +505." styleClass="ayuda" wrapText="true" minHeight="-Infinity" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Correo electrónico *" styleClass="etiqueta" />
                        <TextField fx:id="txtCorreo" promptText="Ej. usuario@correo.com" />
                        <Label text="No puede repetirse entre clientes." styleClass="ayuda" wrapText="true" minHeight="-Infinity" />
                    </VBox>

                    <VBox spacing="5">
                        <CheckBox fx:id="chkActivo" text="Cliente activo" selected="true" />
                        <Label text="Solo los clientes activos aparecen al registrar una cita." styleClass="ayuda" wrapText="true" minHeight="-Infinity" />
                    </VBox>

                    <Label text="* Campos obligatorios" styleClass="ayuda" wrapText="true" minHeight="-Infinity" />

                </VBox>
            </ScrollPane>

            <Region styleClass="separador" />
            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar"
                        styleClass="boton-primario" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar"
                        styleClass="boton-acento" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar"
                        styleClass="boton-neutro" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar"
                        styleClass="boton-peligro" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <!-- Listado y búsqueda de clientes -->
        <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Clientes registrados" styleClass="titulo-seccion" />
                    <Label text="Haga clic en un cliente para cargarlo en el formulario." styleClass="descripcion-seccion" wrapText="true" minHeight="-Infinity" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, apellido o correo" prefWidth="290"
                           styleClass="campo-busqueda" />
            </HBox>

            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No hay clientes para mostrar." />
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" minWidth="50" maxWidth="70" />
                    <TableColumn fx:id="colNombres" text="Nombres" prefWidth="130" />
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="130" />
                    <TableColumn fx:id="colTelefono" text="Teléfono" minWidth="110" prefWidth="120" />
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190" />
                    <TableColumn fx:id="colActivo" text="Estado" minWidth="90" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
