<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" stylesheets="@styles.css" styleClass="ventana"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.MainController">

    <!-- Franja superior navy: marca y estado de la conexión -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="encabezado">
            <StackPane styleClass="logo">
                <Label text="TA" styleClass="logo-texto" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="1">
                <Label text="TecnoAsistencia Nicaragua S.A." styleClass="marca-titulo" />
                <Label text="Gestión de citas de atención técnica" styleClass="marca-subtitulo" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="pildoraConexion" alignment="CENTER_LEFT" styleClass="pildora-conexion">
                <Region fx:id="indicadorConexion" styleClass="indicador" />
                <Label fx:id="lblEstadoConexion" text="Comprobando conexión..." styleClass="texto-estado" />
            </HBox>
        </HBox>
    </top>

    <!-- Pestañas tipo carpeta sobre la franja navy; la activa se une con el contenido -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="pestanas">
            <Tab text="Clientes">
                <graphic>
                    <Region styleClass="icono, icono-clientes" />
                </graphic>
                <fx:include source="ClienteView.fxml" />
            </Tab>
            <Tab fx:id="tabCitas" text="Citas técnicas">
                <graphic>
                    <Region styleClass="icono, icono-citas" />
                </graphic>
                <fx:include fx:id="citaView" source="CitaView.fxml" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
